# Copy to .env and fill in. .env is git-ignored.

# Canvas instance for Minerva Virtual Academy
CANVAS_BASE_URL=https://minervavirtual.instructure.com

# --- Auth: choose ONE ---

# (A) Personal Access Token, if your instance allows it:
#   Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
# NOTE: The MVA instance has this DISABLED, so leave blank and use (B) or (C).
CANVAS_TOKEN=

# (B) Username + password for the Canvas login page. Logs in afresh each run,
#   so there are no cookies to refresh. Does not work with SSO or 2FA.
CANVAS_USERNAME=
CANVAS_PASSWORD=

# (C) Session cookies (used when no token). Produced by:
#   tools/capture_login.py  (log in once)  then  tools/export_session.py
# Path to the exported cookies file; defaults to .pw-session/cookies.json.
CANVAS_COOKIES=.pw-session/cookies.json
