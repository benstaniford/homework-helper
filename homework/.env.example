# Copy to .env (git-ignored) before running docker compose.

# Signs the login cookie and encrypts the stored MVA password inside it.
# Keep it stable: changing it logs everyone out. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Timezone used to show due dates.
TZ=Europe/London

# Host port for the website.
HOST_PORT=5050

# How long to stay logged in, in days.
REMEMBER_DAYS=365

# Set to true if the site is served over HTTPS (e.g. behind a reverse proxy).
SESSION_COOKIE_SECURE=false
